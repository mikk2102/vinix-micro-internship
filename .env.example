APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-project.up.railway.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ──────────────────────────────────────────────────
# DATABASE (Railway MySQL / PostgreSQL / SQLite)
# ──────────────────────────────────────────────────
DB_CONNECTION=mysql                # ganti jadi pgsql kalau pakai PostgreSQL Railway
DB_HOST=${DATABASE_HOST}           # Railway otomatis inject kalau pakai database addon
DB_PORT=${DATABASE_PORT}
DB_DATABASE=${DATABASE_NAME}
DB_USERNAME=${DATABASE_USERNAME}
DB_PASSWORD=${DATABASE_PASSWORD}

# Kalau pakai Railway Private Networking (recommended)
# DB_HOST=${DATABASE_PRIVATE_HOST}

# ──────────────────────────────────────────────────
# CACHE, SESSION & QUEUE – VERSI PALING STABIL DI RAILWAY
# ──────────────────────────────────────────────────
CACHE_DRIVER=file                  # PALING AMAN & CEPAT di Railway
SESSION_DRIVER=file                # Jangan pakai database dulu, sering error
QUEUE_CONNECTION=sync              # Ubah ke database/redis kalau sudah stabil

# Kalau kamu sudah sangat yakin ingin pakai database cache + session:
# CACHE_DRIVER=database
# SESSION_DRIVER=database
# QUEUE_CONNECTION=database

# ──────────────────────────────────────────────────
# FILESYSTEM
# ──────────────────────────────────────────────────
FILESYSTEM_DISK=public             # supaya storage link langsung jalan

# ──────────────────────────────────────────────────
# BROADCAST, REDIS, MAIL (bisa diisi belakangan)
# ──────────────────────────────────────────────────
BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log                    # ganti ke smtp/resend/mailgun kalau sudah siap
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────────────────────────────────────────
# VITE
# ──────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"